generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TravelRoute {
  id          String   @id @default(cuid())
  date        String
  origin      String
  destination String
  distanceKm  Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
}

model AffiliateProduct {
  id             String     @id @default(cuid())
  productCode    String     @unique
  productName    String
  network        String
  commissionRate Float      @default(0)
  affiliateUrl   String
  winningHook    String
  estRevenue     Float      @default(0)
  videos         VideoJob[]
  createdAt      DateTime   @default(now())
}

model VideoJob {
  id          String           @id @default(cuid())
  productId   String
  product     AffiliateProduct @relation(fields: [productId], references: [id])
  videoUrl    String?
  renderState String           @default("SCRIPTING")
  gateStatus  String           @default("PENDING")
  platforms   String[]
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
}
